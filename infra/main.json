                "scopes": [
                  "[parameters('appInsightsId')]"
                ],
                "criteria": {
                  "allOf": [
                    {
                      "query": "            traces\r\n            | where severityLevel >= 3\r\n            | where cloud_RoleName =~ \"${functionAppName}\"\r\n            | project timestamp, message = substring(message, 0, 200)\r\n            | summarize errorCount = count(), errors = strcat_array(make_set(message, 10), ' | ') by bin(timestamp, 15m)\r\n          ",
                      "timeAggregation": "Count",
                      "operator": "GreaterThan",
                      "threshold": 0,
                      "dimensions": [
