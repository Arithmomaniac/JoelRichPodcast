          "resources": [
            {
              "type": "Microsoft.Insights/actionGroups",
              "apiVersion": "2023-01-01",
              "name": "[format('{0}-alerts-ag', parameters('functionAppName'))]",
              "location": "global",
              "properties": {
                "groupShortName": "PodcastAlrt",
                "enabled": true,
                "emailReceivers": [
                  {
                    "name": "PodcastAdmin",
